{
  "name": "culinarpg",
  "version": "2.0.0",
  "description": "CulinaRPG — le Solo Leveling de la cuisine. Monte en niveau en cuisinant.",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "images": "node lib/images.js",
    "setup": "npm install && prisma db push && node prisma/seed.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "axios": "^1.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
