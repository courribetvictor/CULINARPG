// CulinaRPG — Prisma schema
// PostgreSQL en production (Neon.tech gratuit) et en local.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int      @id @default(autoincrement())
  username       String   @unique
  email          String   @unique
  passwordHash   String
  displayName    String
  bio            String   @default("")
  avatar         String   @default("🧑‍🍳")
  avatarColor    String   @default("violet")
  avatarImage    String?
  chefClass      String?
  selectedTitle  String?
  onboarded      Boolean  @default(false)
  totalXp        Int      @default(0)
  gems           Int      @default(0)
  isPro          Boolean  @default(false)
  currentStreak  Int      @default(0)
  bestStreak     Int      @default(0)
  lastActiveDate String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sessions           Session[]
  skills             UserSkill[]
  dailyCompletions   UserDailyCompletion[]
  recipeCompletions  UserRecipeCompletion[]
  quests             UserQuest[]
  lessonUnlocks      UserLessonUnlock[]
  customRecipes      Recipe[]       @relation("CustomRecipes")
  sentRequests       Friendship[]   @relation("SentRequests")
  receivedRequests   Friendship[]   @relation("ReceivedRequests")
}

model Session {
  id        String   @id // SHA-256 du jeton (le jeton brut n'est jamais stocké)
  userId    Int
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSkill {
  id     Int    @id @default(autoincrement())
  userId Int
  skill  String // knife | fire | seasoning | prep | baking
  xp     Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skill])
}

model DailyTask {
  id          Int     @id @default(autoincrement())
  slug        String  @unique
  title       String
  description String
  icon        String  // nom d'icône Lucide
  skill       String  // compétence récompensée
  xpReward    Int
  active      Boolean @default(true)

  completions UserDailyCompletion[]
}

model UserDailyCompletion {
  id          Int      @id @default(autoincrement())
  userId      Int
  dailyTaskId Int
  date        String   // YYYY-MM-DD
  completedAt DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyTask DailyTask @relation(fields: [dailyTaskId], references: [id], onDelete: Cascade)

  @@unique([userId, dailyTaskId, date])
}

model Recipe {
  id           Int      @id @default(autoincrement())
  externalId   String?  @unique // ex: "base-creme-brulee" ou "mealdb-52768"
  source       String   @default("base") // base | themealdb
  name         String
  description  String
  category     String
  area         String?
  searchText   String   @default("") // nom + catégorie + ingrédients, minuscules sans accents
  wikiTitle    String?  // article Wikipédia utilisé pour la photo
  imageUrl     String?
  imageSource  String?  // page d'origine de la photo (crédit)
  imageChecked Boolean  @default(false)
  emoji        String   @default("🍽️")
  timeMinutes  Int
  difficulty   Int      // 1 à 5
  ingredients  String   // JSON: [{ name, measure }]
  instructions String
  skillRewards String   // JSON: { knife: 40, fire: 25, ... }
  mainSkill    String   @default("prep") // compétence la plus récompensée (filtre)
  totalXp      Int
  isCustom     Boolean  @default(false)
  creatorId    Int?
  creator      User?    @relation("CustomRecipes", fields: [creatorId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  completions UserRecipeCompletion[]

  @@index([category])
  @@index([mainSkill])
  @@index([name])
}

model UserRecipeCompletion {
  id         Int      @id @default(autoincrement())
  userId     Int
  recipeId   Int
  xpGained   Int
  cookedAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserQuest {
  id           Int       @id @default(autoincrement())
  userId       Int
  title        String
  description  String    @default("")
  skill        String
  icon         String    @default("target")
  targetCount  Int       @default(1)
  currentCount Int       @default(0)
  completed    Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Lesson {
  id          Int    @id @default(autoincrement())
  slug        String @unique
  title       String
  description String
  category    String
  skill       String
  difficulty  Int
  icon        String
  content     String
  gemCost     Int    @default(0)
  xpReward    Int    @default(80)
  order       Int    @default(0)

  unlocks UserLessonUnlock[]
}

model Friendship {
  id          Int      @id @default(autoincrement())
  requesterId Int
  addresseeId Int
  status      String   @default("pending") // pending | accepted
  createdAt   DateTime @default(now())

  requester User @relation("SentRequests",     fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("ReceivedRequests", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

model UserLessonUnlock {
  id          Int      @id @default(autoincrement())
  userId      Int
  lessonId    Int
  completed   Boolean  @default(false)
  completedAt DateTime?
  unlockedAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}
