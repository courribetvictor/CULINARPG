# Base PostgreSQL (Neon recommandé : https://neon.tech, offre gratuite)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
PORT=3000
# Optionnel
# SEED_DEMO_USER=true        # crée demo@culinarpg.app / demo1234
# MEALDB_IMPORT=true         # ajoute les recettes (anglaises) de TheMealDB
# COOKIE_SECURE=true         # cookies Secure (HTTPS)
# TRUST_PROXY=1              # derrière un reverse proxy (Render, Cloudflare…)
# CORS_ORIGINS=https://app.example.com
# RESOLVE_IMAGES_ON_START=false
