# ─── Base de données ──────────────────────────────────────────────────────────

# SQLite (dev local et Render avec disque persistant) — simple, aucun service externe
DATABASE_URL="file:./dev.db"

# PostgreSQL (Neon, production haute dispo) — décommenter à la place de SQLite :
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Changer aussi provider = "sqlite" → "postgresql" dans prisma/schema.prisma

# ─── Serveur ──────────────────────────────────────────────────────────────────

# Port du serveur Node.js (Render impose le sien via la variable PORT automatique)
PORT=3000

# URL publique de l'app (obligatoire pour les redirections Stripe)
# Sur Render : https://<nom-du-service>.onrender.com
APP_URL=https://your-app.onrender.com

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Clés disponibles sur https://dashboard.stripe.com/apikeys
# Laisser vide → mode simulation (aucun paiement réel, pratique en dev)
STRIPE_SECRET_KEY=sk_test_...
# Secret du webhook (obtenu via `stripe listen` en dev, ou Dashboard → Webhooks en prod)
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Options avancées ─────────────────────────────────────────────────────────
# SEED_DEMO_USER=true       # Crée demo@culinarpg.app / demo1234 au démarrage
# MEALDB_IMPORT=true        # Importe les recettes de TheMealDB
# COOKIE_SECURE=true        # Cookies Secure (HTTPS requis — activé automatiquement sur Render)
# TRUST_PROXY=1             # Derrière un reverse proxy (Render, Cloudflare…)
# CORS_ORIGINS=https://app.example.com
# RESOLVE_IMAGES_ON_START=false
